# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*.o
*.so
build/
dist/
*.egg-info/
.eggs/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# flatpak-builder state: source checkouts, build dirs and caches. This can
# reach several GB, so it is never committed and is also skipped by the
# directory source in the manifest.
.flatpak-builder/
.flatpak-builder-build/
flatpak-builder-repo/

# Built Flatpak bundles and local OCI repos
*.flatpak
*.flatpakrepo
.flatpak/

# Locally compiled helper probe
smartcard_channel_probe

# Leftovers from patch application
*.orig
*.rej
